<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KCStreamer.MainPage">

    <VerticalStackLayout Spacing="25" 
                         Padding="30" 
                         VerticalOptions="Center">
        
        <Label Text="Aktuelle Leistung:" 
               FontSize="24" 
               HorizontalOptions="Center" />

        <!-- Ausgabe der Leistungsdaten -->
        <Label x:Name="PowerLabel" 
               Text="0 W" 
               FontSize="48" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" />

        <Label x:Name="CadenceLabel" 
               Text="0 rpm ?" 
               FontSize="48" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" />
        
    </VerticalStackLayout>

</ContentPage>