<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="KCStreamer.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:KCStreamer"
    Title="KCStreamer">

    <ShellContent
        Title="Home"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="Hello"
        ContentTemplate="{DataTemplate local:View.HelloPage}"
        Route="HelloPage" />
    
</Shell>
